# Copy to .env.local. These are PUBLIC build-time values, never secrets.
VITE_CONTENT_SOURCE=json
VITE_CHAT_SOURCE=demo
VITE_API_BASE_URL=/api/v1
VITE_SITE_URL=https://sai-nagendra-portfolio.ysainagendra.chatgpt.site
# API mode requires the deployed Express backend. There is no mock fallback.

# Public OIDC SPA configuration. No client secret is used in the browser.
# Register /admin/callback as the exact redirect URI; require Authorization Code + PKCE.
# VITE_OIDC_AUTHORITY=https://your-provider.example/
# VITE_OIDC_CLIENT_ID=your-public-spa-client-id
# VITE_OIDC_SCOPE=openid profile
# VITE_OIDC_AUDIENCE=portfolio-api

